ENV=local

# Local host-run defaults. Keep these enabled for normal local development.
USE_LOCAL_DATABASE_IN_DEV=true
LOCAL_DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app
USE_LOCAL_REDIS_IN_DEV=true
LOCAL_REDIS_URL=redis://127.0.0.1:6379/0

# Remote services stay available for non-local environments or when the local
# overrides above are disabled.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://HOST:6379/0

SUPABASE_JWT_SECRET=change-me
SUPABASE_JWT_ALG=HS256
ALLOW_DEV_AUTH=true
DEV_USER_ID=11111111-1111-1111-1111-111111111111
DEV_USER_EMAIL=local-organizer@syzy.dev

APP_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000

# How often celery beat sweeps for due reminders (minutes).
REMINDER_SWEEP_INTERVAL_MINUTES=15
# Days a freshly created share link stays valid before it 410s and is cleaned up.
SHARE_LINK_TTL_DAYS=30

NOTIFICATION_MODE=file
NOTIFICATION_FROM_EMAIL=noreply@syzy.dev
NOTIFICATION_OUTBOX_DIR=dev_outbox

# SMS delivery. "file" writes to the outbox (default); "twilio" sends live and
# requires all three TWILIO_* values below.
SMS_MODE=file
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar OAuth. Leave blank to keep /v1/calendar/google/connect off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/calendar/google/callback
