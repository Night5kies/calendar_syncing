# Backend API base URL. Defaults to http://127.0.0.1:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Organizer auth (Supabase). Leave BOTH unset for local dev — the app then runs
# without sign-in and the backend dev-auth fallback handles organizer requests.
# Set BOTH to enable real organizer auth (magic-link sign-in + bearer tokens).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
